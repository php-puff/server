{
    "name": "puff/server",
    "description": "Protocol-independent Fiber TCP and UDP servers for PHP Fiber Framework",
    "type": "library",
    "keywords": [
        "php",
        "server",
        "tcp",
        "fiber",
        "event-loop",
        "http-server",
        "mcp-server",
        "mqtt-server",
        "websocket-server",
        "puff"
    ],
    "license": "MIT",
    "require": {
        "puff/async": "dev-main",
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Server\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse src tests --level=8 --memory-limit=1G",
        "test": "phpunit tests",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "homepage": "https://github.com/php-puff/server",
    "support": {
        "issues": "https://github.com/php-puff/server/issues",
        "source": "https://github.com/php-puff/server"
    }
}
